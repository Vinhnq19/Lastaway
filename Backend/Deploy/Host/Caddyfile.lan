{
    auto_https off
}
https://:8443 {
    tls /lan-tls/server.crt /lan-tls/server.key
    @internal path /internal /internal/*
    handle @internal {
        respond 404
    }
    handle /game {
        reverse_proxy game-server:7781
    }
    @swagger path /swagger /swagger/*
    basic_auth @swagger {
        {$SWAGGER_USER} {$SWAGGER_HASH}
    }
    reverse_proxy api:5000
}
