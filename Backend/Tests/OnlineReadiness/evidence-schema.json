{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "scenarioId",
    "status",
    "physicalDeviceCount",
    "metrics",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scenarioId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INVALID"
      ]
    },
    "physicalDeviceCount": {
      "const": 1
    },
    "selectedTransport": {
      "type": [
        "string",
        "null"
      ]
    },
    "fallbackReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "connectedSeconds": {
          "type": "number"
        },
        "inputHz": {
          "type": "number"
        },
        "snapshotHz": {
          "type": "number"
        },
        "rttP50Ms": {
          "type": "number"
        },
        "rttP95Ms": {
          "type": "number"
        },
        "rttP99Ms": {
          "type": "number"
        },
        "pings": {
          "type": "number"
        },
        "pongs": {
          "type": "number"
        },
        "pongTimeouts": {
          "type": "number"
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WAIT",
              "NOT_OBSERVED"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "qualityTargetFps": {
      "enum": [
        0,
        60
      ]
    },
    "screenWidth": {
      "type": "integer",
      "minimum": 0
    },
    "screenHeight": {
      "type": "integer",
      "minimum": 0
    },
    "backgroundFrames": {
      "type": "integer",
      "minimum": 0
    },
    "qualitySampleCapReached": {
      "type": "boolean"
    },
    "frameQuality": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "phase",
          "frames",
          "fps",
          "p95Ms",
          "p99Ms",
          "stalls100Ms"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "frames": {
            "type": "integer",
            "minimum": 0
          },
          "fps": {
            "type": "number",
            "minimum": 0
          },
          "p95Ms": {
            "type": "number",
            "minimum": 0
          },
          "p99Ms": {
            "type": "number",
            "minimum": 0
          },
          "stalls100Ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
